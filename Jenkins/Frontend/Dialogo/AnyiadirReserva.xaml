<mah:MetroWindow x:Class="Jenkins.Frontend.Dialogo.AnyiadirReserva"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Jenkins.Frontend.Dialogo"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d"
      Height="700"
      Width="600"
      Title="Añadir Reserva">

    <Grid>

        <!-- ===================== -->
        <!-- CABECERA -->
        <!-- ===================== -->
        <Grid Height="100" VerticalAlignment="Top">
            <Rectangle Fill="#454545"/>
            <TextBlock
                Text="RESERVA DE MESA"
                FontSize="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="White"/>
        </Grid>

        <!-- ===================== -->
        <!-- CONTENIDO -->
        <!-- ===================== -->
        <Grid Margin="10">

            <TextBlock
                Text="Los campos con asterisco son obligatorios"
                Margin="10,100,0,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                FontSize="16"
                FontWeight="Bold"/>

            <!-- ===================== -->
            <!-- DATOS DE LA RESERVA -->
            <!-- ===================== -->

            <TextBlock
                Text="DATOS DE LA RESERVA"
                Margin="10,140,0,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                FontSize="26"
                Foreground="Red"/>

            <Line
                X1="10"
                Y1="50"
                X2="580"
                Y2="50"
                Stroke="DarkGray"
                StrokeThickness="1"
                Margin="0,130,0,0"/>

            <!-- COLUMNA IZQUIERDA -->
            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="300"
                Margin="0,200,0,0">

                <!-- Cliente -->
                

                <ComboBox
                Width="230"
                Height="50"
                SelectedItem="{Binding Reserva.NumeroPersonas}"
                mat:HintAssist.Hint="Número de personas*"
                Style="{StaticResource MaterialDesignOutlinedComboBox}">

                    <ComboBox.Items>
                        <sys:Int32>1</sys:Int32>
                        <sys:Int32>2</sys:Int32>
                        <sys:Int32>3</sys:Int32>
                        <sys:Int32>4</sys:Int32>
                        <sys:Int32>5</sys:Int32>
                        <sys:Int32>6</sys:Int32>
                        <sys:Int32>7</sys:Int32>
                        <sys:Int32>8</sys:Int32>
                        <sys:Int32>9</sys:Int32>
                        <sys:Int32>10</sys:Int32>
                        <sys:Int32>11</sys:Int32>
                        <sys:Int32>12</sys:Int32>
                        <sys:Int32>13</sys:Int32>
                        <sys:Int32>14</sys:Int32>
                        <sys:Int32>15</sys:Int32>
                        <sys:Int32>16</sys:Int32>
                        <sys:Int32>17</sys:Int32>
                        <sys:Int32>18</sys:Int32>
                        <sys:Int32>19</sys:Int32>
                        <sys:Int32>20</sys:Int32>
                    </ComboBox.Items>
                </ComboBox>

                <!-- Fecha -->
                <DatePicker
                    Width="230"
                    Height="40"
                    SelectedDate="{Binding Reserva.Fecha}"
                    mat:HintAssist.Hint="Fecha de la reserva*"
                    Style="{StaticResource MaterialDesignDatePicker}"/>

            </StackPanel>

            <!-- COLUMNA DERECHA -->
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="300"
                Margin="0,200,0,0">

                <!-- Hora inicio -->
                <TextBox
                    Width="230"
                    Height="40"
                    Text="{Binding Reserva.HoraInicio}"
                    mat:HintAssist.Hint="Hora de la reserva"/>

                <!-- Hora fin -->
                

                <!-- Numero de personas -->
                


            </StackPanel>

            <!-- ===================== -->
            <!-- MESAS -->
            <!-- ===================== -->

            <TextBlock
                Text="MESAS"
                Margin="10,380,0,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                FontSize="26"
                Foreground="Red"/>

            <Line
                X1="10"
                Y1="50"
                X2="580"
                Y2="50"
                Stroke="DarkGray"
                StrokeThickness="1"
                Margin="0,370,0,0"/>

            <ListBox
                Margin="30,440,30,0"
                Height="120"
                ItemsSource="{Binding MesasDisponibles}"
                SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding NombreMesa}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ===================== -->
            <!-- OBSERVACIONES -->
            <!-- ===================== -->

            <TextBlock
                Text="Observaciones"
                Margin="31,575,31,0"
                VerticalAlignment="Top"/>

            <TextBox
                Height="60"
                Margin="31,590,31,0"
                Text="{Binding Reserva.Observaciones}"
                TextWrapping="Wrap"/>

        </Grid>

        <!-- ===================== -->
        <!-- BOTONES -->
        <!-- ===================== -->
        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,10,31,40">

            <Button
                Content="Cancelar"
                Width="100"
                Height="35"
                Margin="0,0,20,0"
                Style="{StaticResource MaterialDesignFlatButton}"/>

            <Button
                Content="Guardar"
                Width="100"
                Height="35"
                Style="{StaticResource MaterialDesignFlatButton}"/>

        </StackPanel>

    </Grid>
</mah:MetroWindow>
